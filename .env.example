# Optional fast provider for greetings, basic arithmetic, and short explicit text transformations
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
AI_HISTORY_LIMIT=50
AI_MAX_OUTPUT_TOKENS=2000
AI_COOLDOWN_SECONDS=15
AI_MAX_CONCURRENT=2
# Optional: comma-separated channel IDs. A parent channel also permits its threads.
AI_ALLOWED_CHANNEL_IDS=

# Existing backup settings
BACKUP_CHANNEL_ID=
BACKUP_MAX_MESSAGES_PER_CHANNEL=2000
